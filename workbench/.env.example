# ---- 团队账号 ----
# 会话签名密钥，随便生成一串 32 位以上随机字符串；生产必须配置
AUTH_SECRET=
# 首次启动自动建号，格式：username:password:显示姓名，多个用英文逗号分隔
# 例：SEED_USERS=zhangsan:Passw0rd2026:张三,lisi:Passw0rd2026:李四
# 生产环境建议留空，改用 npm run create-user 逐个创建（或在容器内执行）
SEED_USERS=
# 仅在纯 HTTP 内网联调时设为 0；正式 HTTPS 环境保持默认（不填即为安全 Cookie）
COOKIE_SECURE=1

# ---- 数据存储 ----
# SQLite 数据库所在目录，默认 ./data，Docker 中为 /app/data
DATA_DIR=./data

# ---- 模型接入（火山引擎方舟，OpenAI 兼容）----
# 未配置 ARK_API_KEY 或设置 DEMO_MODE=1 时，工作台以“演示模式”运行：
# 用本地模板产出成稿，可在没有模型额度时完整走通流程
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 方舟的接入点 ID 或模型 ID，例如 ep-2024xxxx 或 doubao-seed-1-6-250615
ARK_MODEL=
DEMO_MODE=0

# ---- 手动暂停开关 ----
# 设为 1 时立即停止生成（异常用量或对外演示结束后使用）
PAUSED=0
